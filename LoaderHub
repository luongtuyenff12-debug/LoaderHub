local Players       = game:GetService("Players")
local TweenService  = game:GetService("TweenService")
local LocalPlayer   = Players.LocalPlayer
local PlayerGui     = LocalPlayer:WaitForChild("PlayerGui")

-- ══════════════════════════════════════════
--              MÀU SẮC THEME
-- ══════════════════════════════════════════
local C = {
    BG         = Color3.fromRGB(30, 20, 45),      -- nền panel tím đậm
    BG2        = Color3.fromRGB(22, 14, 35),      -- nền row thông báo
    BORDER     = Color3.fromRGB(120, 60, 200),    -- viền tím
    BORDER2    = Color3.fromRGB(90, 40, 160),     -- viền tím nhạt hơn
    TITLE      = Color3.fromRGB(180, 100, 255),   -- tím sáng cho tiêu đề
    TEXT       = Color3.fromRGB(200, 160, 255),   -- tím nhạt cho text thường
    WHITE      = Color3.fromRGB(255, 255, 255),
    WARN_BG    = Color3.fromRGB(60, 35, 90),      -- nền icon tam giác
    WARN_ICO   = Color3.fromRGB(160, 80, 255),    -- màu tam giác
    BAR_BG     = Color3.fromRGB(40, 25, 65),      -- nền thanh progress
    BAR_FILL   = Color3.fromRGB(140, 60, 220),    -- màu fill thanh progress
    OVERLAY    = Color3.fromRGB(0, 0, 0),
}

-- ══════════════════════════════════════════
--           HÀM TẠO GUI LOADER
-- ══════════════════════════════════════════
local function CreateLoader()
    if PlayerGui:FindFirstChild("LoaderHubGui") then
        PlayerGui.LoaderHubGui:Destroy()
    end

    -- Root ScreenGui
    local SG = Instance.new("ScreenGui")
    SG.Name               = "LoaderHubGui"
    SG.ResetOnSpawn       = false
    SG.ZIndexBehavior     = Enum.ZIndexBehavior.Sibling
    SG.IgnoreGuiInset     = true
    SG.Parent             = PlayerGui

    -- Nền overlay mờ (giống ảnh)
    local Overlay = Instance.new("Frame")
    Overlay.Name                  = "Overlay"
    Overlay.Size                  = UDim2.new(1,0,1,0)
    Overlay.BackgroundColor3      = C.OVERLAY
    Overlay.BackgroundTransparency = 0.55
    Overlay.BorderSizePixel       = 0
    Overlay.ZIndex                = 1
    Overlay.Parent                = SG

    -- ── PANEL CHÍNH (giống notification box trong ảnh) ──
    local Panel = Instance.new("Frame")
    Panel.Name                  = "Panel"
    Panel.Size                  = UDim2.new(0, 460, 0, 260)
    Panel.Position              = UDim2.new(0.5, -230, 0.5, -130)
    Panel.BackgroundColor3      = C.BG
    Panel.BackgroundTransparency = 0.08
    Panel.BorderSizePixel       = 0
    Panel.ZIndex                = 2
    Panel.Parent                = SG

    Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 10)

    local PanelStroke = Instance.new("UIStroke", Panel)
    PanelStroke.Color     = C.BORDER
    PanelStroke.Thickness = 2
    PanelStroke.Transparency = 0

    -- Viền trái dày (accent bar tím, giống đường tím trong ảnh)
    local LeftAccent = Instance.new("Frame", Panel)
    LeftAccent.Size             = UDim2.new(0, 4, 1, 0)
    LeftAccent.Position         = UDim2.new(0, 0, 0, 0)
    LeftAccent.BackgroundColor3 = C.BORDER
    LeftAccent.BorderSizePixel  = 0
    LeftAccent.ZIndex           = 3
    Instance.new("UICorner", LeftAccent).CornerRadius = UDim.new(0, 10)

    -- ── HEADER (tên "Loader Hub" với icon) ──
    local Header = Instance.new("Frame", Panel)
    Header.Size             = UDim2.new(1, -4, 0, 46)
    Header.Position         = UDim2.new(0, 4, 0, 0)
    Header.BackgroundColor3 = Color3.fromRGB(50, 28, 80)
    Header.BackgroundTransparency = 0.1
    Header.BorderSizePixel  = 0
    Header.ZIndex           = 3
    Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 10)

    -- Icon ⚠ ở header
    local HeaderIcon = Instance.new("TextLabel", Header)
    HeaderIcon.Size                = UDim2.new(0, 40, 1, 0)
    HeaderIcon.Position            = UDim2.new(0, 10, 0, 0)
    HeaderIcon.BackgroundTransparency = 1
    HeaderIcon.Text                = "⚠"
    HeaderIcon.TextColor3          = C.WARN_ICO
    HeaderIcon.TextScaled          = true
    HeaderIcon.Font                = Enum.Font.GothamBold
    HeaderIcon.ZIndex              = 4

    -- Tiêu đề "Loader Hub"
    local TitleLabel = Instance.new("TextLabel", Header)
    TitleLabel.Size               = UDim2.new(1, -60, 1, 0)
    TitleLabel.Position           = UDim2.new(0, 54, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text               = "Loader Hub"
    TitleLabel.TextColor3         = C.TITLE
    TitleLabel.TextScaled         = true
    TitleLabel.Font               = Enum.Font.GothamBold
    TitleLabel.TextXAlignment     = Enum.TextXAlignment.Left
    TitleLabel.ZIndex             = 4

    -- ── ROW THÔNG BÁO 1 (giống "Item has spawned") ──
    local function MakeNotifRow(parent, yPos, iconText, line1, line2)
        local Row = Instance.new("Frame", parent)
        Row.Size             = UDim2.new(1, -20, 0, 58)
        Row.Position         = UDim2.new(0, 10, 0, yPos)
        Row.BackgroundColor3 = C.BG2
        Row.BackgroundTransparency = 0.1
        Row.BorderSizePixel  = 0
        Row.ZIndex           = 3
        Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 7)

        local RowStroke = Instance.new("UIStroke", Row)
        RowStroke.Color     = C.BORDER2
        RowStroke.Thickness = 1.5

        -- Accent line trái của row
        local RowAccent = Instance.new("Frame", Row)
        RowAccent.Size             = UDim2.new(0, 3, 1, 0)
        RowAccent.BackgroundColor3 = C.WARN_ICO
        RowAccent.BorderSizePixel  = 0
        RowAccent.ZIndex           = 4
        Instance.new("UICorner", RowAccent).CornerRadius = UDim.new(0, 7)

        -- Icon tam giác ⚠ (nền vuông tím)
        local IconBox = Instance.new("Frame", Row)
        IconBox.Size             = UDim2.new(0, 40, 0, 40)
        IconBox.Position         = UDim2.new(0, 12, 0.5, -20)
        IconBox.BackgroundColor3 = C.WARN_BG
        IconBox.BorderSizePixel  = 0
        IconBox.ZIndex           = 4
        Instance.new("UICorner", IconBox).CornerRadius = UDim.new(0, 6)

        local IconLabel = Instance.new("TextLabel", IconBox)
        IconLabel.Size                = UDim2.new(1, 0, 1, 0)
        IconLabel.BackgroundTransparency = 1
        IconLabel.Text                = iconText
        IconLabel.TextColor3          = C.WARN_ICO
        IconLabel.TextScaled          = true
        IconLabel.Font                = Enum.Font.GothamBold
        IconLabel.ZIndex              = 5

        -- Dòng text 1
        local L1 = Instance.new("TextLabel", Row)
        L1.Name                   = "Line1"
        L1.Size                   = UDim2.new(1, -68, 0, 26)
        L1.Position               = UDim2.new(0, 62, 0, 6)
        L1.BackgroundTransparency = 1
        L1.Text                   = line1
        L1.TextColor3             = C.WHITE
        L1.TextScaled             = true
        L1.Font                   = Enum.Font.GothamBold
        L1.TextXAlignment         = Enum.TextXAlignment.Left
        L1.ZIndex                 = 4

        -- Dòng text 2 (tím nhạt, nhỏ hơn)
        local L2 = Instance.new("TextLabel", Row)
        L2.Name                   = "Line2"
        L2.Size                   = UDim2.new(1, -68, 0, 22)
        L2.Position               = UDim2.new(0, 62, 0, 30)
        L2.BackgroundTransparency = 1
        L2.Text                   = line2
        L2.TextColor3             = C.TEXT
        L2.TextScaled             = true
        L2.Font                   = Enum.Font.Gotham
        L2.TextXAlignment         = Enum.TextXAlignment.Left
        L2.ZIndex                 = 4

        return Row, L1, L2
    end

    local Row1, R1L1, R1L2 = MakeNotifRow(Panel, 54,  "⚠", "Đang kết nối server...", "Vui lòng chờ trong giây lát")
    local Row2, R2L1, R2L2 = MakeNotifRow(Panel, 120, "⚠", "Đang tải script...",     "Loader Hub đang khởi động")

    -- ── THANH PROGRESS (giống đường tím dưới thông báo) ──
    local BarBG = Instance.new("Frame", Panel)
    BarBG.Size             = UDim2.new(1, -20, 0, 10)
    BarBG.Position         = UDim2.new(0, 10, 0, 188)
    BarBG.BackgroundColor3 = C.BAR_BG
    BarBG.BorderSizePixel  = 0
    BarBG.ZIndex           = 3
    Instance.new("UICorner", BarBG).CornerRadius = UDim.new(1, 0)

    local UIStrokeBar = Instance.new("UIStroke", BarBG)
    UIStrokeBar.Color     = C.BORDER2
    UIStrokeBar.Thickness = 1

    local BarFill = Instance.new("Frame", BarBG)
    BarFill.Name             = "BarFill"
    BarFill.Size             = UDim2.new(0, 0, 1, 0)
    BarFill.BackgroundColor3 = C.BAR_FILL
    BarFill.BorderSizePixel  = 0
    BarFill.ZIndex           = 4
    Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1, 0)

    -- Gradient trên fill
    local FillGrad = Instance.new("UIGradient", BarFill)
    FillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 40, 180)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 100, 255)),
    })

    -- Label % và status dưới thanh
    local PctLabel = Instance.new("TextLabel", Panel)
    PctLabel.Name                 = "PctLabel"
    PctLabel.Size                 = UDim2.new(0.5, 0, 0, 22)
    PctLabel.Position             = UDim2.new(0, 10, 0, 202)
    PctLabel.BackgroundTransparency = 1
    PctLabel.Text                 = "0%"
    PctLabel.TextColor3           = C.TITLE
    PctLabel.TextScaled           = true
    PctLabel.Font                 = Enum.Font.GothamBold
    PctLabel.TextXAlignment       = Enum.TextXAlignment.Left
    PctLabel.ZIndex               = 3

    local StatusLabel = Instance.new("TextLabel", Panel)
    StatusLabel.Name              = "StatusLabel"
    StatusLabel.Size              = UDim2.new(0.5, -10, 0, 22)
    StatusLabel.Position          = UDim2.new(0.5, 0, 0, 202)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text              = "Đang khởi động..."
    StatusLabel.TextColor3        = C.TEXT
    StatusLabel.TextScaled        = true
    StatusLabel.Font              = Enum.Font.Gotham
    StatusLabel.TextXAlignment    = Enum.TextXAlignment.Right
    StatusLabel.ZIndex            = 3

    -- Footer credit
    local Footer = Instance.new("TextLabel", Panel)
    Footer.Size                   = UDim2.new(1, -10, 0, 18)
    Footer.Position               = UDim2.new(0, 5, 1, -22)
    Footer.BackgroundTransparency = 1
    Footer.Text                   = "© LoaderHub  |  Anime Blox Fruit"
    Footer.TextColor3             = Color3.fromRGB(110, 70, 160)
    Footer.TextScaled             = true
    Footer.Font                   = Enum.Font.Gotham
    Footer.ZIndex                 = 3

    return SG, Panel, BarFill, PctLabel, StatusLabel, R1L1, R1L2, R2L1, R2L2
end

-- ══════════════════════════════════════════
--         ANIMATE LOADER + PROGRESS
-- ══════════════════════════════════════════
local function RunLoader(SG, Panel, BarFill, PctLabel, StatusLabel, R1L1, R1L2, R2L1, R2L2)

    -- Fade in Panel
    Panel.BackgroundTransparency = 1
    Panel.Position = UDim2.new(0.5, -230, 0.5, -150)
    TweenService:Create(Panel, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.08,
        Position = UDim2.new(0.5, -230, 0.5, -130),
    }):Play()
    task.wait(0.45)

    local steps = {
        { pct=0.12, s1="Đang kết nối server...",      s2="Vui lòng chờ trong giây lát",  r1="Kết nối server...",    r2="Thiết lập kết nối bảo mật",      delay=0.55 },
        { pct=0.30, s1="Xác minh phiên bản...",       s2="Kiểm tra cập nhật mới nhất",   r1="Xác minh...",          r2="Phiên bản hợp lệ",                delay=0.55 },
        { pct=0.50, s1="Đang tải script...",           s2="Loader Hub đang khởi động",    r1="Tải script...",        r2="Nhận dữ liệu từ server",          delay=0.65 },
        { pct=0.70, s1="Giải mã dữ liệu...",          s2="Xử lý payload...",             r1="Giải mã...",           r2="Phân tích cấu trúc module",       delay=0.55 },
        { pct=0.88, s1="Inject module...",             s2="Cài đặt các thành phần",       r1="Inject...",            r2="Nạp các thành phần vào game",     delay=0.55 },
        { pct=1.00, s1="✔ Hoàn tất!",                 s2="Chào mừng đến Loader Hub",     r1="✔ Sẵn sàng!",         r2="Script đã được khởi động",        delay=0.40 },
    }

    for _, st in ipairs(steps) do
        task.wait(st.delay)

        -- Cập nhật nội dung row thông báo
        R1L1.Text = st.r1
        R1L2.Text = st.r2
        R2L1.Text = st.s1
        R2L2.Text = st.s2

        -- Tween thanh progress
        TweenService:Create(BarFill, TweenInfo.new(0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(st.pct, 0, 1, 0)
        }):Play()

        PctLabel.Text    = math.floor(st.pct * 100) .. "%"
        StatusLabel.Text = st.s1
    end

    task.wait(0.6)

    -- Fade out
    TweenService:Create(Panel, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, -230, 0.5, -110),
    }):Play()
    TweenService:Create(SG:FindFirstChild("Overlay"), TweenInfo.new(0.5), {
        BackgroundTransparency = 1
    }):Play()

    task.wait(0.6)
    SG:Destroy()
end

-- ══════════════════════════════════════════
--           LOAD SCRIPT CHÍNH
-- ══════════════════════════════════════════
local function LoadScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/luongtuyenkqpa/Anime-bloxfuit/refs/heads/main/Animemodhub"))()
    end)
    if success then
        print("[LoaderHub] ✔ Script chạy thành công!")
    else
        warn("[LoaderHub] ✘ Lỗi: " .. tostring(err))
    end
end

-- ══════════════════════════════════════════
--              KHỞI ĐỘNG CHÍNH
-- ══════════════════════════════════════════
local function Run()
    local SG, Panel, BarFill, PctLabel, StatusLabel, R1L1, R1L2, R2L1, R2L2 = CreateLoader()
    task.spawn(RunLoader, SG, Panel, BarFill, PctLabel, StatusLabel, R1L1, R1L2, R2L1, R2L2)
    LoadScript()
end

local function OnCharacterAdded(character)
    character:WaitForChild("HumanoidRootPart", 10)
    task.wait(2)
    Run()
end

if LocalPlayer.Character then
    task.spawn(function()
        task.wait(2)
        Run()
    end)
end

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

print("[LoaderHub] Script loader đã khởi động!")
