    end)

    -- Nhấn Enter trong TextBox
    Input.FocusLost:Connect(function(enterPressed)
        if enterPressed then doVerify() end
    end)

    -- Hover effect nút
    BtnDetector.MouseEnter:Connect(function()
        TweenService:Create(BtnFrame, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(0, 100, 190)
        }):Play()
