-- ══════════════════════════════════════════
--          HTTP POST HELPER (multi-executor)
-- ══════════════════════════════════════════
local function httpPost(url, payload)
    local body    = HttpService:JSONEncode(payload)
    local headers = {
        ["Content-Type"] = "application/json",
        ["Accept"]       = "application/json",
    }
    local function tryPost()
        if request then
            local ok, res = pcall(request, { Url=url, Method="POST", Headers=headers, Body=body })
            if ok and res and res.Body and #res.Body > 0 then return res.Body end
        end
        if syn and syn.request then
            local ok, res = pcall(syn.request, { Url=url, Method="POST", Headers=headers, Body=body })
            if ok and res and res.Body and #res.Body > 0 then return res.Body end
        end
        if http and http.request then
            local ok, res = pcall(http.request, { Url=url, Method="POST", Headers=headers, Body=body })
            if ok and res and res.Body and #res.Body > 0 then return res.Body end
        end
        if HttpService.RequestAsync then
            local ok, res = pcall(function()
                return HttpService:RequestAsync({ Url=url, Method="POST", Headers=headers, Body=body })
            end)
            if ok and res and res.Body and #res.Body > 0 then return res.Body end
        end
        return nil
    end
    for attempt = 1, 3 do
        local result = tryPost()
        if result then return result end
        if attempt < 3 then task.wait(attempt) end
    end
    -- Fallback GET
    local getUrl = url
        .. "?key="    .. HttpService:UrlEncode(tostring(payload.key    or ""))
        .. "&app="    .. HttpService:UrlEncode(tostring(payload.app    or ""))
        .. "&device=" .. HttpService:UrlEncode(tostring(payload.device or ""))
    local ok, res = pcall(function() return game:HttpGet(getUrl) end)
    if ok and res and #res > 0 then return res end
    return nil
end

-- ══════════════════════════════════════════
--     VERIFY KEY VỚI SERVER
-- ══════════════════════════════════════════
local function verifyKey(key)
    local rawBody = nil
    pcall(function()
        rawBody = httpPost(SERVER_URL .. "/api/verify", {
            key           = key,
            app           = APP_ID,
            device        = _DEVICE_ID,
            platform      = "roblox",
            deviceName    = _DEVICE_NAME,
            androidVersion = _ANDROID_VER,
        })
    end)
    if not rawBody or rawBody == "" then return nil end
    local ok, result = pcall(function() return HttpService:JSONDecode(rawBody) end)
    if ok and result then return result end
    return nil
end

-- ══════════════════════════════════════════
--     LƯU KEY VÀO FILE (để AMH tự đọc)
-- ══════════════════════════════════════════
local function saveKeyForAMH(key, keyType, expireTime)
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode({
                key        = key,
                keyType    = keyType    or "NORMAL",
                expireTime = expireTime or 0,
            }))
        end
    end)
end

