    local function doVerify()
        if _verifying then return end
        local key = Input.Text:match("^%s*(.-)%s*$") -- trim
        if key == "" then
            ErrLabel.Text      = "⚠ Vui lòng nhập key!"
            ErrLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
            return
        end

        _verifying = true
        BtnLabel.Text      = "Đang xác thực..."
        ErrLabel.Text      = "⏳ Đang kiểm tra key..."
        ErrLabel.TextColor3 = Color3.fromRGB(100, 200, 255)

        task.spawn(function()
            local result = verifyKey(key)

            if not result then
                -- Không kết nối được server
                ErrLabel.Text       = "❌ Không thể kết nối server. Thử lại!"
                ErrLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                BtnLabel.Text       = "ĐĂNG NHẬP"
                _verifying          = false
                return
            end

            if result.valid then
                -- ✅ KEY HỢP LỆ
                local keyType    = result.keyType    or result.type        or "NORMAL"
                local expireTime = result.expireTime or result.expire_time or 0

                ErrLabel.Text       = "✅ Key hợp lệ! Đang tải..."
                ErrLabel.TextColor3 = Color3.fromRGB(0, 220, 120)
                BtnLabel.Text       = "THÀNH CÔNG ✓"

                -- Lưu key vào file để Animemodhub tự đọc
