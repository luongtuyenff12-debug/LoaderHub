-- ══════════════════════════════════════════
--           ANIMATE PROGRESS BAR
-- ══════════════════════════════════════════

local function AnimateLoader(ScreenGui, Panel)
    local StatusLabel = Panel:FindFirstChild("StatusLabel", true)
    local ProgressBar = Panel:FindFirstChild("ProgressBar", true)
    local PercentLabel = Panel:FindFirstChild("PercentLabel", true)

    local steps = {
        {text = "► Connecting to remote server...",    pct = 0.15, delay = 0.6},
        {text = "► Fetching script payload...",         pct = 0.35, delay = 0.7},
        {text = "► Decrypting data stream...",          pct = 0.55, delay = 0.6},
        {text = "► Injecting modules...",               pct = 0.75, delay = 0.5},
        {text = "► Verifying integrity...",             pct = 0.90, delay = 0.5},
        {text = "✔ System ready. Launching...",         pct = 1.00, delay = 0.4},
    }

    for _, step in ipairs(steps) do
        task.wait(step.delay)
        if StatusLabel then StatusLabel.Text = step.text end

        -- Tween thanh progress
        TweenService:Create(ProgressBar,
            TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.new(step.pct, 0, 1, 0)}
        ):Play()

        -- Cập nhật phần trăm
        local pct = math.floor(step.pct * 100)
        if PercentLabel then PercentLabel.Text = pct .. "%" end
    end

    task.wait(0.5)

    -- Fade out toàn bộ UI
    local Overlay = ScreenGui:FindFirstChild("Frame") -- overlay đen
    TweenService:Create(ScreenGui:FindFirstChildOfClass("Frame"),
        TweenInfo.new(0.6, Enum.EasingStyle.Quart),
        {BackgroundTransparency = 1}
    ):Play()
    TweenService:Create(Panel,
        TweenInfo.new(0.5, Enum.EasingStyle.Quart),
        {
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, -240, 0.5, -130)
        }
    ):Play()

    task.wait(0.7)
    ScreenGui:Destroy()
end

-- ══════════════════════════════════════════
--           LOAD SCRIPT CHÍNH
-- ══════════════════════════════════════════

local function LoadScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/luongtuyenkqpa/Anime-bloxfuit/refs/heads/main/Animemodhub"))()
    end)

    if success then
        print("[AutoLoad] Script đã chạy thành công!")
    else
        warn("[AutoLoad] Lỗi khi chạy script: " .. tostring(err))
    end
end

-- ══════════════════════════════════════════
--             KHỞI ĐỘNG CHÍNH
-- ══════════════════════════════════════════

local function Run()
    local ScreenGui, Panel = CreateLoader()
    AnimateLoader(ScreenGui, Panel)
    LoadScript()
end

-- Chờ character load xong
local function OnCharacterAdded(character)
    character:WaitForChild("HumanoidRootPart", 10)
    task.wait(2)
    Run()
end

-- Lần đầu vào game
if LocalPlayer.Character then
    task.spawn(function()
        task.wait(2)
        Run()
    end)
end

-- Tự động chạy lại khi respawn
LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

print("[AutoLoad] Script loader đã khởi động!")
