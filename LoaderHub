-- ══════════════════════════════════════════
--  ANIMATION LOADER → CHẠY AMH
-- ══════════════════════════════════════════
local function RunLoaderThenLoad()
    local SG, Panel, Shadow, BarFill, PctLabel, StatusLabel = CreateCornerLoader()

    -- Slide-in
    Panel.Position  = UDim2.new(1, 10,  1, -108)
    Shadow.Position = UDim2.new(1, 12,  1, -109)
    TweenService:Create(Panel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -232, 1, -108)
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -234, 1, -109)
    }):Play()
    task.wait(0.45)

    RunPercentLoader(BarFill, PctLabel, StatusLabel)
    task.wait(0.4)

    -- Slide-out
    TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 10, 1, -108)
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 12, 1, -109)
    }):Play()
    task.wait(0.4)
    SG:Destroy()

    -- Chạy Animemodhub (sẽ tự đọc key đã lưu → bỏ qua bước nhập tay)
    LoadScript()
end

-- ══════════════════════════════════════════
--              KHỞI ĐỘNG CHÍNH
-- ══════════════════════════════════════════
local function Run()
    -- Kiểm tra xem đã có key hợp lệ được lưu chưa
    local hasSavedKey = false
    pcall(function()
        if isfile and isfile(SAVE_FILE) then
            local data = HttpService:JSONDecode(readfile(SAVE_FILE))
            if data and data.key and data.key ~= "" then
                -- Kiểm tra chưa hết hạn (expireTime = 0 = không giới hạn)
                if data.expireTime == 0 or data.expireTime > os.time() then
                    hasSavedKey = true
                end
            end
        end
    end)

    if hasSavedKey then
        -- Đã có key hợp lệ → chạy thẳng loader
        print("[LoaderHub] 🔑 Key đã lưu hợp lệ, bỏ qua bước nhập key")
        RunLoaderThenLoad()
    else
        -- Chưa có key → hiện Key Gate
        ShowKeyGate(function()
            -- Callback sau khi key thành công
            RunLoaderThenLoad()
        end)
    end
end

