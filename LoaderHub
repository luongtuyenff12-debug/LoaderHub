local function RunPercentLoader(BarFill, PctLabel, StatusLabel)
    local statusMap = {
        [5]   = "Kết nối server...",
        [20]  = "Xác minh phiên bản...",
        [40]  = "Đang tải script...",
        [60]  = "Giải mã dữ liệu...",
        [80]  = "Inject module...",
        [95]  = "Hoàn thiện...",
        [100] = "Hoàn tất!",
    }
    for pct = 1, 100 do
        if statusMap[pct] then StatusLabel.Text = statusMap[pct] end
        TweenService:Create(BarFill,
            TweenInfo.new(0.03, Enum.EasingStyle.Linear),
            { Size = UDim2.new(pct / 100, 0, 1, 0) }
        ):Play()
        PctLabel.Text = pct .. "%"
        if pct < 30 then task.wait(0.025)
        elseif pct < 70 then task.wait(0.045)
        elseif pct < 95 then task.wait(0.035)
        else task.wait(0.05) end
    end
end

