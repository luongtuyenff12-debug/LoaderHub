-- ══════════════════════════════════════════
--        CHẠY % TỪ 1 → 100
-- ══════════════════════════════════════════
local function RunPercentLoader(BarFill, PctLabel, StatusLabel)
    local statusMap = {
        [5]   = "Kết nối server...",
        [20]  = "Xác minh phiên bản...",
        [40]  = "Đang tải script...",
        [60]  = "Giải mã dữ liệu...",
        [80]  = "Inject module...",
        [95]  = "Hoàn thiện...",
        [100] = "✔ Sẵn sàng!",
    }

    for pct = 1, 100 do
        if statusMap[pct] then
            StatusLabel.Text = statusMap[pct]
        end

        TweenService:Create(BarFill,
            TweenInfo.new(0.03, Enum.EasingStyle.Linear),
            { Size = UDim2.new(pct / 100, 0, 1, 0) }
        ):Play()

        PctLabel.Text = pct .. "%"

        if pct < 30 then
            task.wait(0.025)
        elseif pct < 70 then
            task.wait(0.045)
        elseif pct < 95 then
            task.wait(0.035)
        else
            task.wait(0.05)
        end
    end
end

-- ══════════════════════════════════════════
--           LOAD SCRIPT CHÍNH
-- ══════════════════════════════════════════
local function LoadScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/luongtuyenkqpa/Anime-bloxfuit/refs/heads/main/Animemodhub"))()
    end)
    if success then
        print("[LoaderHub] ✔ Script chạy thành công!")
    else
        warn("[LoaderHub] ✘ Lỗi: " .. tostring(err))
    end
end

-- ══════════════════════════════════════════
--              KHỞI ĐỘNG CHÍNH
-- ══════════════════════════════════════════
local function Run()
    local SG, Panel, Shadow, BarFill, PctLabel, StatusLabel = CreateCornerLoader()

    -- Slide-in từ phải
    Panel.Position  = UDim2.new(1, 10, 1, -110)
    Shadow.Position = UDim2.new(1, 12, 1, -108)

    TweenService:Create(Panel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -230, 1, -110)
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -232, 1, -108)
    }):Play()

    task.wait(0.45)

    -- Chạy % 1→100 (chặn đến khi xong)
    RunPercentLoader(BarFill, PctLabel, StatusLabel)

    task.wait(0.4)

    -- Slide-out ra phải
    TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 10, 1, -110)
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 12, 1, -108)
    }):Play()

    task.wait(0.4)
    SG:Destroy()

    -- ✅ Chỉ execute SAU KHI đạt 100%
    LoadScript()
end

local function OnCharacterAdded(character)
    character:WaitForChild("HumanoidRootPart", 10)
    task.wait(2)
    Run()
end

if LocalPlayer.Character then
    task.spawn(function()
        task.wait(2)
        Run()
    end)
end

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

print("[LoaderHub] Loader khởi động!")
