                -- Đợi 0.8s để animation hoàn tất
                task.wait(0.8)

                -- Đóng Key Gate
                TweenService:Create(Card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Position               = UDim2.new(0.5, -150, 0.5, -165),
                    BackgroundTransparency = 1,
                }):Play()
                task.wait(0.32)
                SG:Destroy()

                -- Callback → chạy loader animation rồi load AMH
                if onSuccess then onSuccess() end

            else
                -- ❌ KEY KHÔNG HỢP LỆ
                local reason = result.reason or "invalid"
                local msg = "❌ Key không hợp lệ!"
                if reason == "expired"       then msg = "⌛ Key đã hết hạn!"
                elseif reason == "banned"    then msg = "🚫 Key bị banned!"
                elseif reason == "key_not_found" then msg = "🔍 Key không tồn tại!"
                elseif reason == "app_denied"    then msg = "⛔ Key không thuộc app này!"
                end
                ErrLabel.Text       = msg
                ErrLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

                -- Rung nhẹ input
                local origPos = InputBG.Position
                TweenService:Create(InputBG, TweenInfo.new(0.05), { Position = UDim2.new(0, 22, 0, 122) }):Play()
                task.wait(0.06)
                TweenService:Create(InputBG, TweenInfo.new(0.05), { Position = UDim2.new(0, 6,  0, 122) }):Play()
                task.wait(0.06)
                TweenService:Create(InputBG, TweenInfo.new(0.05), { Position = origPos }):Play()

                BtnLabel.Text = "ĐĂNG NHẬP"
                _verifying    = false
            end
        end)
    end

    -- Bấm nút
    local BtnDetector = Instance.new("TextButton", BtnFrame)
    BtnDetector.Size                   = UDim2.new(1, 0, 1, 0)
    BtnDetector.BackgroundTransparency = 1
    BtnDetector.Text                   = ""
    BtnDetector.ZIndex                 = 25
    BtnDetector.MouseButton1Click:Connect(function()
