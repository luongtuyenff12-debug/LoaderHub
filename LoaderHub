    Panel.Name                   = "Panel"
    Panel.Size                   = UDim2.new(0, 220, 0, 90)
    Panel.Position               = UDim2.new(1, -230, 1, -110)
    Panel.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
    Panel.BackgroundTransparency = 0
    Panel.BorderSizePixel        = 0
    Panel.ZIndex                 = 10
    Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 14)

    local PanelStroke = Instance.new("UIStroke", Panel)
    PanelStroke.Color     = Color3.fromRGB(220, 220, 220)
    PanelStroke.Thickness = 2

    -- Shadow
    local Shadow = Instance.new("Frame", SG)
    Shadow.Size                   = UDim2.new(0, 224, 0, 94)
    Shadow.Position               = UDim2.new(1, -232, 1, -108)
    Shadow.BackgroundColor3       = Color3.fromRGB(180, 180, 180)
    Shadow.BackgroundTransparency = 0.7
    Shadow.BorderSizePixel        = 0
    Shadow.ZIndex                 = 9
    Instance.new("UICorner", Shadow).CornerRadius = UDim.new(0, 16)

